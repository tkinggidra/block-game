# Java
*.class
*.log

# Gradle
.gradle/
**/build/

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Dear ImGui
imgui.ini

# JVM crash reports
hs_err_pid*
replay_pid*

# Generated archives and distributions
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Gradle Wrapper (required for reproducible builds)
!gradle/wrapper/gradle-wrapper.jar

# Operating system
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.bak
*.swp
*~
